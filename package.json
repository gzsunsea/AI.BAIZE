{
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "refresh": "node server/jobs/refresh.js",
    "cleanup:quality": "node server/jobs/cleanupQuality.js",
    "test": "node --test server/*.test.js server/site/*.test.js server/lib/*.test.js src/lib/*.test.mts",
    "typecheck": "npm run typecheck -w @aihot/web",
    "build": "npm run build -w @aihot/web",
    "preview": "vite preview --host 0.0.0.0",
    "test:web": "node --test apps/web/tests/*.test.ts",
    "start:web": "npm start -w @aihot/web"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cheerio": "^1.1.2",
    "entities": "^8.1.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "name": "aibaize",
